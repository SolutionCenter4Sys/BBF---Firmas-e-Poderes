# KAS_RUN_URL e KAS_API_KEY NÃO vivem no Next.js (WF-07).
# Chave só no Worker .NET:
#   Kas__ApiKey
#   Kas__RunUrl
#   Kas__TimeoutSeconds=300
#
# Upload público: POST /v1/documents (202). Worker consome outbox.
#
# compose.yaml usa este ficheiro (env_file). Copiar para .env se precisares de overrides locais.
# ConnectionStrings no compose aponta a Host=db (rede interna). Appsettings local continua Host=localhost.

NEXT_PUBLIC_API_URL=http://localhost:8080
API_INTERNAL_URL=http://api:8080

POSTGRES_USER=bbf
POSTGRES_PASSWORD=bbf
POSTGRES_DB=bbf_firmas

ConnectionStrings__Postgres=Host=db;Port=5432;Database=bbf_firmas;Username=bbf;Password=bbf

Jwt__Issuer=https://bbf.local
Jwt__Audience=bbf-firmas-poderes
Jwt__SigningKey=dev-only-change-me-32-chars-min!!

Documents__StorageRoot=/data/docs
Documents__MaxUploadBytes=52428800

# compose.yaml interpola ${Kas__ApiKey} só no serviço worker (ficheiro .env gitignorado).
# Não colocar a chave neste example. Sem chave = demo só seed; upload live vai a falha.
Kas__ApiKey=
Kas__RunUrl=https://kaas-core-dev.up.railway.app/kas/triggers/journeys/testes-firmas-e-poderes/run
Kas__TimeoutSeconds=300
Kas__PollIntervalSeconds=5

Database__MigrateOnStartup=true

# Login demo (WF-20). API sobe sem isto; POST /v1/auth/login precisa.
DemoUsers__OperadorEmail=ana.silva@bbf.com.br
DemoUsers__OperadorPassword=OperadorDemo!2026
DemoUsers__AuditorEmail=auditor.interno@bbf.com.br
DemoUsers__AuditorPassword=AuditorDemo!2026
